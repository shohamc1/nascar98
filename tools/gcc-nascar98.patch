--- a/config/mips/mips.c
+++ b/config/mips/mips.c
@@ -5629,0 +5630,21 @@
+
+
+/* Nonzero if INSN is a sign-extending byte load (lb) that depends on the
+   store DEP_INSN.  Used by ADJUST_COST for the measured PSX schedule.  */
+
+int
+mips_store_to_lb_p (insn, dep_insn)
+     rtx insn, dep_insn;
+{
+  rtx pat = PATTERN (insn), src;
+
+  if (GET_CODE (pat) != SET)
+    return 0;
+  src = SET_SRC (pat);
+  if (GET_CODE (src) != SIGN_EXTEND
+      || GET_CODE (XEXP (src, 0)) != MEM
+      || GET_MODE (XEXP (src, 0)) != QImode)
+    return 0;
+  return recog_memoized (dep_insn) >= 0
+	 && get_attr_type (dep_insn) == TYPE_STORE;
+}
